<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.daily_work_todo.mapper.PrioritysMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.daily_work_todo.entity.Prioritys">
        <id property="priorityId" column="priority_id" jdbcType="VARCHAR"/>
        <result property="priorityName" column="priority_name" jdbcType="VARCHAR"/>
        <result property="priorityOrder" column="priority_order" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        priority_id, priority_name, priority_order
    </sql>

    <!-- 新增、按主键删除/更新/查询、查询全部均使用 MyBatis-Plus BaseMapper 内置实现， -->
    <!-- 此处不再定义 insert、deleteById、updateById、selectById、selectAll，以免覆盖内置方法导致参数名冲突（et） -->

</mapper>
