<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.daily_work_todo.mapper.PersonalTaskMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.daily_work_todo.entity.PersonalTask">
        <id property="ptId" column="pt_id" jdbcType="VARCHAR"/>
        <result property="content" column="content" jdbcType="VARCHAR"/>
        <result property="tagId" column="tag_id" jdbcType="VARCHAR"/>
        <result property="createdTme" column="created_tme" jdbcType="TIMESTAMP"/>
        <result property="updatedTime" column="updated_time" jdbcType="TIMESTAMP"/>
        <result property="priorityId" column="priority_id" jdbcType="VARCHAR"/>
        <result property="ptStatusId" column="pt_status_id" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        pt_id, content, tag_id, created_tme, updated_time, priority_id, pt_status_id
    </sql>

    <!-- 新增、按主键删除/更新/查询、查询全部均使用 MyBatis-Plus BaseMapper 内置实现， -->
    <!-- 此处不再定义 insert、deleteById、updateById、selectById、selectAll，以免覆盖内置方法导致参数名冲突（et） -->

</mapper>
